cabal-version: 3.0
name:           haskplayground
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/hyperswine/haskplayground#readme>
homepage:       https://github.com/hyperswine/haskplayground#readme
bug-reports:    https://github.com/hyperswine/haskplayground/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/hyperswine/haskplayground

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules
    -Wpartial-fields -Wredundant-constraints
  default-language: Haskell2010

common deps
  build-depends:
        aeson
      , array
      , base >=4.7 && <5
      , brick
      , bytestring
      , clash-prelude
      , containers
      , directory
      , filepath
      , vector
      , vty
      , vty-crossplatform

library
  import: warnings, deps
  hs-source-dirs: src
  exposed-modules:
        DTs
      , MyClash
      , MyData
      , MyStuff
      , QuantUI
      , WASM.Actors
      , WASM.Main
      , WASM.TestMain
      , WASM.WasmVM
      , WASM.WatParser

executable haskplayground-exe
  import: warnings, deps
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: haskplayground
  ghc-options: -O2 -threaded -rtsopts -with-rtsopts=-N

test-suite haskplayground-test
  import: warnings, deps
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends: haskplayground, hedgehog
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
