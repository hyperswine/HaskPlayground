# The pipeline demo, now written in actual Sol syntax.
# Row-poly getter, linear handle, 3-deep fusion chain, branch-local record.

# infers r : {x : a | rest}
getx r = r.x.

# would generate get_x and get_y, would be an alias rather than its own type
# MyStuff : Sig.
# MyStuff = {x : Int, y : Int}.

main =
  # rec1 : {x : Int, y : Int}, which satisfies the row-polymorphic type {x : a | rest}, so getx can be applied to it
  rec1 = {x = 10, y = 20};
  h = newHandle (getx rec1); # h is a linear handle to the x field of rec1, h must be used once and only once
  v1 = fromTo 1 rec1.y;

  # should result in 3 lifted functions
  # results in 2 fused functions v2-v3 and (v2-v3)-v4, supposed to inline rather than =fused0(x)
  v2 = mapV (fn a -> a * 2) v1;
  v3 = mapV (fn b -> b + 1) v2;
  v4 = mapV (fn c -> c * 3) v3;

  s = sumV v4;
  w = {x = s + 1, y = 0};
  t = case s <= 100 of
        True -> getx rec1
      | False -> getx rec1 + w.x;

  t + closeHandle h.
