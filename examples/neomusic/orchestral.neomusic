-- "Old Kingdom": a 16-bar orchestral-style cue in D minor, all synthesized.
tempo 90
tuning 12 at C4
meter 4

sound strings from basic
  osc saw unison 5 detune 18
  osc saw up -12 gain 0.3 unison 3 detune 12
  amp velocity * adsr 0.35 0.5 0.85 0.6
  pitch 0.08 * lfo sine 5.2
  cutoff filter 1400 0.4 (adsr 0.3 1 0.6 0.6) 0.8 1.2
  resonance 0.05  width 0.9
sound pizz from basic
  osc triangle
  osc saw gain 0.3
  amp velocity * adsr 0.002 0.25 0 0.15
  cutoff filter 900 0.5 (adsr 0.001 0.08 0 0.1) 2 1
sound horn from basic
  osc saw
  osc square gain 0.3
  amp velocity * adsr 0.12 0.4 0.8 0.3
  pitch 0.05 * lfo sine 4.5
  cutoff filter 500 0.6 (adsr 0.15 0.6 0.4 0.3) 1.5 1.5
  resonance 0.1
sound flute from basic
  osc triangle
  osc sine up 12 gain 0.15
  osc noise gain 0.04
  amp velocity * adsr 0.06 0.2 0.85 0.15
  pitch 0.1 * then 0.3 0 (lfo sine 5)     -- vibrato that arrives after the attack
  cutoff hz 5000
sound harp from basic
  osc triangle
  osc sine up 12 gain 0.4
  osc sine up 19 gain 0.1
  amp velocity * adsr 0.002 1.6 0 0.8
  cutoff filter 2500 0.5 (adsr 0.001 0.4 0.3 0.4) 1 0.8
sound timpani from basic
  osc sine
  osc noise gain 0.15
  amp velocity * adsr 0.002 1.2 0 0.6
  pitch approach 3 0 0.2
  cutoff hz 900
reverb hall room 0.9 wet 0.45 predelay 0.03
master peak 0.89 tail 3

instrument strings = strings gain 0.22 send 0.6
instrument pizz    = pizz gain 0.4 pan -0.2 send 0.4
instrument harp    = harp gain 0.25 pan 0.35 send 0.5
instrument flute   = flute gain 0.35 pan 0.2 send 0.45
instrument horn    = horn gain 0.3 pan -0.15 send 0.55
instrument timp    = timpani gain 0.6 send 0.5

-- Chords, voiced around middle C (0).
Dm = (-10 -3 2 5)
Bb = (-14 -7 2 5)
F  = (-7 0 5 9)
C  = (-12 -5 4 7)
Gm = (-17 -10 -2 2)
A  = (-15 -8 1 4)
prog1 = Dm:4 Bb:4 F:4 C:4
prog2 = Gm:4 Dm:4 Bb:4 A:4

pz #r = r _ r _
arpm #r = [r [r + 7] [r + 12] [r + 15] [r + 19] [r + 15] [r + 12] [r + 7]]:1/2
arpM #r = [r [r + 7] [r + 12] [r + 16] [r + 19] [r + 16] [r + 12] [r + 7]]:1/2

tune = 14:2 [17 16]:1/2 14   17:3 14   21:2 19 17   16:3 12
       14:2 [17 19]:1/2 21   22:2 21 19   21 [19 17]:1/2 16 17   16:4
echo2 = vel 0.6 [21:2 19 17  16:4  17 16 14 13  14:4]
hornTune = -5:2 -2 2   5:3 2   2:2 0 -2   1:4
           -5:2 -2 2   5 7 9 5   4:2 1:2   2:4
roll = cresc 0.3 0.9 [[-15:1/4]*16]      -- one crescendo across the whole roll

strings: prog1 prog1 cresc 1/3 1 [prog2] rit 2/3 [Gm:4 Dm:4 A:4 hold 2 [Dm:4]]
pizz:    [pz -22 pz -26 pz -19 pz -24]*2 pz -17 pz -22 pz -26 pz -15 pz -17 pz -22 pz -15 -22:4
harp:    [arpm -10 arpM -14 arpM -7 arpM -12]*2 arpm -17 arpm -10 arpM -14 arpM -15 _:16
flute:   tune _:16 echo2
horn:    _:32 hornTune
timp:    -22:4 _:12 -22:4 _:12 _:12 roll -22:4 _:4 -15:4 -22:4
