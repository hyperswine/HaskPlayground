-- "Old Kingdom": a 16-bar orchestral-style cue in D minor, all synthesized.
tempo 90
tuning 12 at C4
meter 4

-- Each instrument is a voice: sources, shaped (see neomusic-voice.md).
-- Strings: a bowed section. Saws through three body resonances, a little bow
-- noise, a vibrato that arrives after the attack, five players slightly apart.
sound strings = gain (velocity * adsr 0.3 0.5 0.85 0.6) (unison 5 16 0.9
    (bend (0.08 * then 0.3 0 (lfo sine 5.2))
      (lowpass (filter 2400 0.3 (adsr 0.3 1 0.6 0.6) 0.6 1) 0.05
        (gain 0.7 bandpass (hz 300) 1.5 tone saw + gain 0.5 bandpass (hz 1100) 1.2 tone saw
         + gain 0.3 bandpass (hz 2600) 1.5 tone saw + gain 0.2 tone saw)
       + gain (0.03 * adsr 0.05 0.3 0.4 0.3) (bandpass (hz 2500) 2 noise))))
-- Pizzicato and harp: plucked strings.
sound pizz = gain (velocity * adsr 0.001 0 1 0.2) (lowpass (hz 1800 + 0.5 * key) 0 plucked 0.5 0.3)
sound harp = gain (velocity * adsr 0.001 0 1 1.2) (lowpass (hz 3000 + 0.3 * key) 0 plucked 2.5 0.55)
-- Flute: a soft tone, a breath at the start, and a little breath throughout,
-- both centred on the note.
sound flute = gain (velocity * adsr 0.08 0.2 0.85 0.15) (bend (0.12 * then 0.35 0 (lfo sine 5))
    (lowpass (hz 4500) 0 (tone triangle + gain 0.15 bend 12 tone sine)
     + gain (0.3 * adsr 0.03 0.12 0.2 0.1) (bandpass key 0.6 noise)
     + gain 0.04 bandpass (key + 1) 1 noise))
-- Horn: a brassy attack (the filter opens with it) and a formant near 480 Hz.
sound horn = gain (velocity * adsr 0.1 0.4 0.8 0.3) (bend (0.04 * lfo sine 4.5)
    (lowpass (filter 450 0.5 (adsr 0.12 0.6 0.4 0.3) 1.5 1.5) 0.1 (tone saw + gain 0.3 tone square)
     + gain 0.6 bandpass (hz 480) 1 tone saw))
-- Timpani: a membrane's partials (1, 1.5 and 2 times the pitch) that drop
-- into tune, and a felt mallet's thud.
sound timpani = gain (velocity * adsr 0.002 1.4 0 0.8) (bend (approach 2 0 0.15)
    (tone sine + gain 0.5 bend 7.02 tone sine + gain 0.25 bend 12 tone sine)
     + gain (0.6 * adsr 0.001 0.08 0 0.05) (bandpass key 1.5 noise))
reverb hall room 0.9 wet 0.45 predelay 0.03
master peak 0.89 tail 3

instrument strings = strings gain 0.3 send 0.6
instrument pizz    = pizz gain 1.1 pan -0.2 send 0.4
instrument harp    = harp gain 0.8 pan 0.35 send 0.5
instrument flute   = flute gain 0.35 pan 0.2 send 0.45
instrument horn    = horn gain 0.2 pan -0.15 send 0.55
instrument timp    = timpani gain 0.55 send 0.5

-- Chords, voiced around middle C (0).
Dm = (-10 -3 2 5)
Bb = (-14 -7 2 5)
F  = (-7 0 5 9)
C  = (-12 -5 4 7)
Gm = (-17 -10 -2 2)
A  = (-15 -8 1 4)
prog1 = Dm:4 Bb:4 F:4 C:4
prog2 = Gm:4 Dm:4 Bb:4 A:4

pz #r = r _ r _
arpm #r = [r [r + 7] [r + 12] [r + 15] [r + 19] [r + 15] [r + 12] [r + 7]]:1/2
arpM #r = [r [r + 7] [r + 12] [r + 16] [r + 19] [r + 16] [r + 12] [r + 7]]:1/2

tune = 14:2 [17 16]:1/2 14   17:3 14   21:2 19 17   16:3 12
       14:2 [17 19]:1/2 21   22:2 21 19   21 [19 17]:1/2 16 17   16:4
echo2 = vel 0.6 [21:2 19 17  16:4  17 16 14 13  14:4]
hornTune = -5:2 -2 2   5:3 2   2:2 0 -2   1:4
           -5:2 -2 2   5 7 9 5   4:2 1:2   2:4
roll = cresc 0.3 0.9 [[-15:1/4]*16]      -- one crescendo across the whole roll

strings: prog1 prog1 cresc 1/3 1 [prog2] rit 2/3 [Gm:4 Dm:4 A:4 hold 2 [Dm:4]]
pizz:    [pz -22 pz -26 pz -19 pz -24]*2 pz -17 pz -22 pz -26 pz -15 pz -17 pz -22 pz -15 -22:4
harp:    [arpm -10 arpM -14 arpM -7 arpM -12]*2 arpm -17 arpm -10 arpM -14 arpM -15 _:16
flute:   tune _:16 echo2
horn:    _:32 hornTune
timp:    -22:4 _:12 -22:4 _:12 _:12 roll -22:4 _:4 -15:4 -22:4
