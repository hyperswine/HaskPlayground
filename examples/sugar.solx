# Syntax sugar torture test.

# alias to a record, not its own type
Point = {x : Int, y : Int}.

# if a is less than or equal to b, return b, otherwise return a
mymax a b = case a <= b of True -> b | False -> a.

double x = x * 2.

# typical guarded clause, with a catch-all clause
describe n | n == 0 = "zero".
describe n | n < 0 = "neg".
describe _ = "pos".

safe_head xs = case xs of
    x :: _ -> Ok x
  | Nil -> Err "empty".

main =
  a = 3 |> double |> fn v -> v + 1;                 # pipeline + trailing lambda
  b = double $ 5 + 1;                               # $ application sugar
  c = 4 `mymax` 9;                                  # backtick infix
  box = {inner = {x = 10, y = 20}, tag = 1};
  box' = {box | inner.y = 99, tag = 2};             # nested + multi-field update
  (h1, h2) = (a, b);                                # tuple refutable let
  v :: rest = [c, 7, 8];                            # cons refutable let
  idx = [10, 20, 30] ! 2;                           # ! lookup, 1-indexed
  r = safe_head [1, 2] |>? fn x -> Ok (x * 100);    # monadic pipeline
  msg = "a={a} b={b} c={c} y'={box'.inner.y} idx={idx} sum={h1 + h2} v={v} rest={rest} lit=\{esc}";

  print msg >> print (describe (0 - 5)) >> print (case r of Ok k -> "ok {k}" | Err e -> e) >> print :done.
