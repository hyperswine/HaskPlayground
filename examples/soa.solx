# Vec (Int, Int) as SoA: the pair-vector is represented as two column
# vectors (the canonical Repr -- no semantic choice, so the compiler applies
# it silently). zipV / fstV / sndV are free; column maps fuse like any maps.

main =
  xs = fromTo 1 10;
  ys = fromTo 11 20;
  ps = zipV xs ys;
  ps2 = mapFstV (fn a -> a * 2) ps;
  ps3 = mapFstV (fn b -> b + 1) ps2;
  ps4 = mapSndV (fn c -> c * 3) ps3;
  sumV (fstV ps4) + sumV (sndV ps4).
